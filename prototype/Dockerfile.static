# syntax=docker.io/docker/dockerfile:1

# Embark India — legacy static site container
# Serves the prototype/ .html files, css/, js/, assets/ via nginx.
# Build: docker build -f prototype/Dockerfile.static -t embark-static ./prototype
# Run:  docker run -p 8080:80 embark-static

FROM nginx:alpine

COPY nginx-static.conf /etc/nginx/conf.d/default.conf
COPY . /usr/share/nginx/html

# Remove files that should not be served publicly
RUN rm -f /usr/share/nginx/html/Dockerfile.static /usr/share/nginx/html/nginx-static.conf /usr/share/nginx/html/.htaccess

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
