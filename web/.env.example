# Database
# Docker local default: postgresql://embark:embark@postgres:5432/embark?schema=public
# Production (Neon): postgresql://user:pass@host/db?schema=public
DATABASE_URL="postgresql://embark:embark@postgres:5432/embark?schema=public"

# Redis
# Docker local default: redis://redis:6379
# Production (upstash / ElastiCache): redis://... or rediss://...
REDIS_URL="redis://redis:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay (use test keys for local Docker, live keys for production)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# S3-compatible file storage
# Docker local default (MinIO): http://minio:9000
# Production (Cloudflare R2): https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="embark-india"
S3_ACCESS_KEY="embark"
S3_SECRET_KEY="embark12345"
S3_PUBLIC_URL=""
AWS_REGION="us-east-1"
# Legacy aliases kept for compatibility
R2_ENDPOINT="http://minio:9000"
S3_BUCKET_NAME="embark-india"
AWS_ACCESS_KEY_ID="embark"
AWS_SECRET_ACCESS_KEY="embark12345"

# Email (Resend for transactional, SMTP fallback for password reset)
# Docker local default: none — emails are logged to console
# Production: set RESEND_API_KEY from https://resend.com
EMAIL_FROM="Embark India <hello@embarkindia.in>"
EMAIL_SERVER=""
RESEND_API_KEY="re_..."

# Observability (optional)
SENTRY_DSN=""
POSTHOG_KEY=""

# Optional Vercel preview URL
VERCEL_URL=""
