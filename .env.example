# Embark India — Docker environment template
# Copy this file to `.env` and update values for production.

# Database
DATABASE_URL="postgresql://embark:embark@postgres:5432/embark?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# Razorpay (test keys for local, live keys for production)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# S3-compatible storage (MinIO for local Docker)
# R2_ENDPOINT is used server-side; inside Docker it points to the minio service.
R2_ENDPOINT="http://minio:9000"
# S3_PUBLIC_URL is the URL returned to browsers. For local Docker it must be
# localhost because the browser is outside the Docker network.
S3_PUBLIC_URL="http://localhost:9000"
S3_BUCKET_NAME="embark-india"
AWS_ACCESS_KEY_ID="embark"
AWS_SECRET_ACCESS_KEY="embark12345"
AWS_REGION="us-east-1"

# Email (SMTP for production)
EMAIL_FROM="Embark India <hello@embarkindia.in>"
EMAIL_SERVER=""
